  "notes": [
    {
      "topic": "admission",
      "text": "Students who have studied Italian previously are encouraged to take the Italian Placement Exam offered through the Language Learning Research Center. High school language study is not counted for college credit. Students who believe they should be placed in a different level should consult the ITL Program Coordinator."
    },
    {
      "topic": "other",
      "text": "Completion of the minor with either emphasis requires 21-27 credits, depending on language placement."
    },
    {
      "topic": "advising",
      "text": "Students interested in teaching Italian should concentrate on courses taught in the Italian language. Students interested in other careers should choose courses in culture, film studies, and Italian American social issues."
    },
    {
      "topic": "other",
      "text": "Minor is available to students majoring in other disciplines."
    }
