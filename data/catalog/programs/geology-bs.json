  "notes": [
    {
      "topic": "advising",
      "text": "Upon declaring the major, the student is assigned a faculty advisor who will assist in the selection of a course sequence leading to the degree. Students should consult frequently with their faculty advisors regarding their progress and regarding appropriate science courses."
    },
    {
      "topic": "other",
      "text": "Geology Honors Program (optional, not evaluated): at least 3 credits of GEO 487 Senior Research in Geology taken with a Research Advisor; a satisfactory written thesis; and an overall GPA of at least 3.30 in all science courses numbered 300 or higher."
    },
    {
      "topic": "other",
      "text": "Suggested clusters of science electives (Geology, Environmental Geoscience, Geological Oceanography) are advisory only and are not requirements."
    },
    {
      "topic": "other",
      "text": "MAT 123 becomes a required course for the major if the student does not place into AMS 151, MAT 125, or MAT 131 on the math placement examination."
    },
    {
      "topic": "other",
      "text": "The Department of Geosciences also offers the Earth and Space Sciences major (B.A.), which has separate requirements."
    },
    {
      "topic": "sbc",
      "text": "SBC courses listed for this major are informational; per-course SBC tags are taken from course records."
    }
  ],
