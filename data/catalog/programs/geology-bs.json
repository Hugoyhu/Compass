    {
      "id": "geology-bs.writing",
      "label": "writing",
      "title": "Upper-Division Writing and Speaking Requirement",
      "rule": {
        "manualCheck": "Completion of the WRTD requires that a 15-page paper written by the student receives a B or higher as determined by the instructor of the 300-400 level GEO course.",
        "type": "allOf",
        "rules": [
          {
            "type": "course",
            "code": "GEO 496"
          },
          {
            "type": "choose",
            "count": 1,
            "from": {
              "ranges": [
                {
                  "subject": "GEO",
                  "from": 300,
                  "to": 400
                }
              ],
              "subjects": [
                "GEO"
              ],
              "excludeCourses": [
                "GEO 496"
              ]
            }
          }
        ]
      },
      "sourceText": "Before graduation all students in the Geology major must register for the 1-credit GEO 496 WRTD course along with a 300-400 level GEO course. Completion of the WRTD requires that a 15-page paper written by the student receives a B or higher as determined by the instructor of the 300-400 level course."
    },
