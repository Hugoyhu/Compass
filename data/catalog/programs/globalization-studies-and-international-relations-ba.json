  "notes": [
    {
      "topic": "advising",
      "text": "Students are encouraged to either participate in a semester abroad study program, or to complete a semester-long internship in an institution, business, or government agency. Courses for Global Flows are selected through consultation with the program advisor or program director."
    },
    {
      "topic": "grading",
      "text": "Satisfactory/Unsatisfactory courses must be passed with an S, and no more than six S/U credits may be applied to the major."
    },
    {
      "topic": "other",
      "text": "Courses marked with * in Global Flows and Global Issues are crosslisted; students earn credit by registering for either course but may not repeat the course under the other option."
    },
    {
      "topic": "other",
      "text": "GLI 212, GLI 391 and GLI 392 count toward Global Issues only when the topic is appropriate."
    },
    {
      "topic": "other",
      "text": "Language Study may be satisfied by equivalent competency demonstrated through a language challenge exam."
    },
    {
      "topic": "other",
      "text": "Completed courses may count toward only one area of the major, even if they are listed in multiple areas."
    },
    {
      "topic": "other",
      "text": "The page lists minors of particular interest to majors, including Africana Studies, Asian and Asian American Studies, China Studies, English, Environmental Humanities, French Language and Literature, History, Italian Studies, Japanese Studies, Korean Studies, Latin American and Caribbean Studies, Middle Eastern Studies, Political Science, Russian Studies, South Asian Studies, Spanish Language and Literature, Sustainability Studies, Theatre Arts, Women's and Gender Studies, and Writing and Rhetoric."
    }
  ],
