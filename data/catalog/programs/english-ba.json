  "notes": [
    {
      "topic": "other",
      "text": "Upper-Division Writing Requirement: satisfactory completion of EGL 301 with a grade of C or better. EGL 301 is also one of the seven upper-division courses above, so it is applied once there; the C-or-better grade is enforced by the program grade policy."
    },
    {
      "topic": "other",
      "text": "The Honors Program in English is an optional program and is not modeled here. It requires an overall GPA of at least 3.0, an English GPA of at least 3.5, and a sample paper. It also requires 45 credits, eight upper-division courses, two Honors Seminars, an Honors Practicum, EGL 496, and a B or higher in 400-level honors courses."
    },
    {
      "topic": "other",
      "text": "The following courses may not be used for the English major: EGL 440, EGL 441, EGL 449, EGL 450, EGL 451, EGL 452, EGL 454, EGL 475, EGL 476. Three credits of EGL 488 may be used toward upper-division electives for the major."
    },
    {
      "topic": "other",
      "text": "With department permission, one course may satisfy up to two topic areas. Alternate courses may be substituted with permission of the program director. Neither exception is modeled."
    },
    {
      "topic": "other",
      "text": "The department also offers a BA English Education Program leading to NYS Adolescence Education certification (grades 7-12), and minors in English, Film and Screen Studies, and Theatre Arts. Minors of particular interest to English majors include Foreign Languages and Journalism (JRN)."
    },
    {
      "topic": "advising",
      "text": "Undergraduate advisor: Charles Edwards. Director of Undergraduate Studies: Justin Johnston."
    }
