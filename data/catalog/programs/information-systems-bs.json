  "notes": [
    {
      "topic": "admission",
      "text": "Area of Interest admission requires completing CSE 114; AMS 151, MAT 125, or MAT 131; and either WRT 102 or ISE 218, with grades of B- or higher and a GPA of 3.00 or higher in these courses (the higher grade is used if both ISE 218 and WRT 102 were taken), repeating at most one of the courses, and a cumulative GPA of 3.00 or higher. Applications are due January 5 (Spring) and June 5 (Fall), and must be made within one year of the first course that applies toward major entry. Students outside Computer Science and Information Systems follow a separate, competitive process; fulfilling the requirements does not guarantee acceptance."
    },
    {
      "topic": "grading",
      "text": "The Pass/No Credit option is not available to ISE majors for ISE courses."
    },
    {
      "topic": "other",
      "text": "The calculus alternative CSE 113 is listed on the page as an OR option to the calculus sequence; it is modeled as an alternative as printed."
    },
    {
      "topic": "other",
      "text": "Courses applied to the System & Network Administration specialization may not be used toward requirements to satisfy the ISE major or minor."
    },
    {
      "topic": "other",
      "text": "The Technological Systems Management specialization notes that courses cross-listed between ISE and EST may be taken either as ISE electives or as TSM specialization electives."
    },
    {
      "topic": "other",
      "text": "The Accelerated BS in ISE + MS in DAS program (nine credits may be applied to both degrees) is an accelerated program and is not modeled here."
    },
    {
      "topic": "other",
      "text": "Declared Computer Science majors may switch to the Information Systems major after exceeding the one-year admission timeline, provided they meet the stated criteria."
    }
  ],
