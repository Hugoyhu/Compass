  "notes": [
    {
      "topic": "other",
      "text": "Completion of the major requires 39 credits, of which 27 to 30 credits are in Sociology courses. This total is not audited separately; it follows from the requirements below."
    },
    {
      "topic": "grading",
      "text": "Excluding required courses, credit can be awarded for just one P graded course."
    },
    {
      "topic": "advising",
      "text": "The upper-division writing requirement is met through SOC 361, which also satisfies the SBC WRTD requirement."
    },
    {
      "topic": "advising",
      "text": "Transfer students must take at least 12 credits in sociology in residence at Stony Brook and may not transfer a sociology course with a grade lower than C for credit in the major."
    },
    {
      "topic": "other",
      "text": "Sociology Honors Program (not evaluated): open to seniors with a 3.50 GPA in the major and 3.20 overall who have completed or are completing the methods and statistics requirement and the upper-division writing requirement. Requires an approved proposal, SOC 495 in the first semester and SOC 496 in the second (six credits total). Honors are conferred if completed with distinction and the student has a 3.50 GPA in all sociology courses and 3.2 overall."
    },
    {
      "topic": "other",
      "text": "Students are encouraged to pursue minors of particular interest: Anthropology (ANT), Health, Medicine and Society (MHS), International Studies (INT), Political Science (POL), Women's and Gender Studies (WST)."
    }
  ],
