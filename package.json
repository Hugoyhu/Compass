{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:catalog": "tsx --tsconfig tsconfig.json scripts/validate-catalog.ts",
    "scrape:programs:fetch": "tsx --tsconfig tsconfig.json utilities/scrapers/major-minor/fetch.ts",
    "scrape:programs:extract": "tsx --tsconfig tsconfig.json utilities/scrapers/major-minor/extract.ts",
    "scrape:programs:eval": "tsx --tsconfig tsconfig.json utilities/scrapers/major-minor/eval.ts",
    "scrape:programs:run": "tsx --tsconfig tsconfig.json utilities/scrapers/major-minor/run.ts",
    "fixtures:transcript": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --no-pdf-header-footer --print-to-pdf=tests/fixtures/transcript/sample-transcript.pdf tests/fixtures/transcript/sample-transcript.html",
    "test:transcript": "tsx --tsconfig tsconfig.json scripts/test-transcript.ts",
    "test:smoke": "tsx --tsconfig tsconfig.json scripts/smoke-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
